#!/usr/bin/env python3
import layersManager
import random
import sys
from chess_positions import partiesTraining, partiesTest
from modelSaver import ModelSaver

def transformBoardToInput(board: list[str]) -> list[list[float]]:
    listPieces = ['r','n','b','q','k','p','R','N','B','Q','K','P']
    listInputs = []
    for piece in listPieces:
        listInputs.append([1.0 if cell == piece else 0.0 for cell in board])
    return listInputs

def tryBoardToInput(inputs, expected, layers: layersManager.layersManager, board=None, turn=None):
    layers.setInputs(inputs)
    layers.forwardCompute()
    outputs = [n.getOutput() for n in layers.getOutputLayer()]
    pred_idx = outputs.index(max(outputs))
    idx_to_label = {0: "Nothing", 1: "Check", 2: "Checkmate"}
    pred = idx_to_label[pred_idx]
    # Display original board if provided
    if board:
        for i in range(8):
            print("".join(board[i*8:(i+1)*8]))
    print(f"->{turn} (pred: {pred}, expected: {idx_to_label[expected.index(max(expected))]})")
    print()
    if pred_idx == expected.index(max(expected)):
        return 1
    return 0

def test_model(layers, label_to_onehot):
    """Test the model on test set"""
    print("\nTesting on separate test set:")
    nb_validated = 0
    
    for turn, party, target in partiesTest:
        board_layers = transformBoardToInput(party)
        board_layers.insert(0, [1.0 if turn == "w" else 0.0])
        inputTest = [val for layer in board_layers for val in layer]
        nb_validated += tryBoardToInput(inputTest, label_to_onehot[target], layers, party, turn)
    
    test_accuracy = (nb_validated / len(partiesTest)) * 100
    print(f"Test set: {test_accuracy:.2f}% correct.")
    return test_accuracy

def main():

    # Parse command line arguments
    model_path = "models/chess_model.json"
    mode = "train"  # default mode
    save = False
    seed = None
    
    # Simple argument parsing
    if len(sys.argv) > 1:
        if sys.argv[1] in ["--load", "-l"]:
            mode = "load"
            if len(sys.argv) > 2:
                model_path = sys.argv[2]
        elif sys.argv[1] in ["--help", "-h"]:
            print("USAGE")
            print("\t./my_torch_analyzer [--predict | --train [--save SAVEFILE]] LOADFILE CHESSFILE")
            print("")
            print("DESCRIPTION")
            print("\t--train Launch the neural network in training mode. Each chessboard in FILE must contain inputs to send to the neural network in FEN notation and the expected output separated by space. If specified, the newly trained neural network will be saved in SAVEFILE. Otherwise, it will be saved in the original LOADFILE.")
            print("\t--predict Launch the neural network in prediction mode. Each chessboard in FILE must contain inputs to send to the neural network in FEN notation, and optionally an expected output.")
            print("\t--save Save neural network into SAVEFILE. Only works in train mode.")
            print("")
            print("\tLOADFILE File containing an artificial neural network")
            print("\tCHESSFILE File containing chessboards")
            return

    if seed is None:
        seed = random.randint(0, 1000000)
        print(f"Using random seed: {seed}")
    random.seed(seed)
    # Create network (adjust learningRate if needed)
    # 12 piece types × 64 squares + 1 turn indicator = 769 inputs
    layers = layersManager.layersManager(inputNb=769, hiddenNb=[128, 64], outputNb=3, learningRate=0.05)

    inputs = []
    targets = []
    # Map string labels to one-hot vectors: [Nothing, Check, Checkmate]
    label_to_onehot = {"Nothing": [1.0, 0.0, 0.0], "Check": [0.0, 1.0, 0.0], "Checkmate": [0.0, 0.0, 1.0]}
    for turn, party, target in partiesTraining:
        # Use transformBoardToInput and flatten to single vector
        board_layers = transformBoardToInput(party)
        board_layers.insert(0, [1.0 if turn == "w" else 0.0])  # Add turn indicator layer
        flattened = [val for layer in board_layers for val in layer]
        inputs.append(flattened)
        targets.append(label_to_onehot[target])

    if mode == "load":
        # Load existing model
        print(f"\nLoading model from {model_path}...")
        try:
            layers = ModelSaver.load_model(model_path)
            
            # Test the loaded model
            accuracy = layers.evaluateValidation(inputs, targets)
            print(f"Training set accuracy: {accuracy*100:.2f}%")
            
            test_accuracy = test_model(layers, label_to_onehot)
            
        except Exception as e:
            print(f"Failed to load model: {e}")
            return

    else:
        isValidation = False
        maxEpochs = 100000
        currentEpoch = 0

        while not isValidation:
            currentEpoch += 1
            # Shuffle order each epoch
            indices = list(range(len(inputs)))
            random.shuffle(indices)

            for i in indices:
                layers.setInputs(inputs[i])
                layers.forwardCompute()
                layers.backpropagate(targets, i)

            # Evaluate once per epoch
            accuracy = layers.evaluateValidation(inputs, targets)
            if accuracy == 1.0:
                isValidation = True
                print(f"Perfect accuracy reached at epoch {currentEpoch}")
                break
            if currentEpoch >= maxEpochs:
                print("Max epochs reached without perfect accuracy.")
                break

        accuracy = layers.evaluateValidation(inputs, targets)
        for i, (turn, party, target) in enumerate(partiesTraining):
            tryBoardToInput(inputs[i], targets[i], layers, party, turn)
        print("\nTesting on separate test set:")
        nb_validated = 0
        for turn, party, target in partiesTest:
            board_layers = transformBoardToInput(party)
            board_layers.insert(0, [1.0 if turn == "w" else 0.0])  # Add turn indicator layer for test
            inputTest = [val for layer in board_layers for val in layer]
            nb_validated += tryBoardToInput(inputTest, label_to_onehot[target], layers, party, turn)

        print(f"Training completed with accuracy: {accuracy*100:.2f}%")
        print(f"Test set: {((nb_validated / len(partiesTest)) * 100):.2f}% correct.")
        save_choice = input("\nSave this model? (y/n): ").strip().lower()
        if save_choice == 'y':
            custom_path = input(f"Enter path (default: {model_path}): ").strip()
            if custom_path:
                model_path = custom_path
            
            if ModelSaver.save_model(layers, model_path):
                print(f"Model saved successfully!")
                print(f"To load this model later, run:")
                print(f"  python My_TorchAnalyzer.py --load {model_path}")

if __name__ == '__main__':
    main()